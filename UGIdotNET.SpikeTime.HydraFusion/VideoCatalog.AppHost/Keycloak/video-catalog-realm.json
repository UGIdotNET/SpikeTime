{
  "realm": "video-catalog",
  "displayName": "Video Catalog",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "video-admin",
        "description": "Gestisce i contenuti del catalogo video."
      }
    ]
  },
  "clients": [
    {
      "clientId": "admin-api",
      "name": "Video Catalog Admin API",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "admin-portal",
      "name": "Video Catalog Admin Portal",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${ADMIN_PORTAL_CLIENT_SECRET}",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "https://localhost:7027/signin-oidc",
        "http://localhost:5280/signin-oidc"
      ],
      "webOrigins": [
        "https://localhost:7027",
        "http://localhost:5280"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost:7027/signout-callback-oidc##http://localhost:5280/signout-callback-oidc"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "admin api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "admin-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Video",
      "lastName": "Administrator",
      "email": "admin@video-catalog.local",
      "realmRoles": [
        "video-admin"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${VIDEO_ADMIN_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
